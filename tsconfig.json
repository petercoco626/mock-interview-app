{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/assets/*": ["assets/*"],
      "@/components/*": ["components/*"],
      "@/constants/*": ["constants/*"],
      "@/hooks/*": ["hooks/*"],
      "@/libs/*": ["libs/*"],
      "@/screens/*": ["screens/*"],
      "@/service/*": ["service/*"],
      "@/stores/*": ["stores/*"],
      "@/types/*": ["types/*"]
    }
  }
}
